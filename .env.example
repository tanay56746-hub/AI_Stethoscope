# ==============================================================================
# [LAYER: ENVIRONMENT TEMPLATE] | File: .env.example
# Purpose: Safe Template for Environment Variables & API Keys (Committed to Git)
# Copy this file to `.env` and fill in any private API keys.
# ==============================================================================

# 1. Backend Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ALLOWED_ORIGINS=*

# 2. Frontend Vite Configuration
VITE_FRONTEND_HOST=127.0.0.1
VITE_FRONTEND_PORT=5173
VITE_BACKEND_URL=http://127.0.0.1:8000
VITE_API_BASE_URL=/api

# 3. Vercel / Cloud Serverless Proxy Configuration
EXTERNAL_BACKEND_URL=

# 4. ML Model & Pretrained Checkpoint Paths
MODEL_CHECKPOINT_PATH=experiments/multitask_ablations/cnn_physical_panns/checkpoints/best_checkpoint.pt
PANNS_WEIGHTS_PATH=pretrained_weights/Cnn14_mAP=0.431.pth

# 5. API Keys & External Service Secrets
API_SECRET_KEY=your_secret_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
HF_TOKEN=your_huggingface_token_here
